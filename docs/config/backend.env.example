# Example configuration for the implementation; no secrets.
TRANSIT_MODE=demo
# Defaults must resolve against repository root, not shell cwd.
TRANSIT_SOURCE_DIR=data/raw
# Leave DB path unset to select separate demo/live default databases.
TOMTOM_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Use account/endpoint appropriate to intended use; commercial access may need a key.
OPEN_METEO_API_KEY=
WEATHER_DELAY_POLICY=advisory_only
OPERATOR_BULLETIN_FEED_URL=
OPERATOR_BULLETIN_FEED_TRUSTED=false
